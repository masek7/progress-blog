---
// src/components/ThemeToggle.astro
---

<div class="theme-toggle-container">
  <input type="checkbox" id="theme-switch" aria-label="Alternar tema" />
  <label class="toggle-track" for="theme-switch">
    <div class="toggle-thumb">
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </div>
  </label>
</div>

<style>
  .theme-toggle-container { display: flex; align-items: center; justify-content: center; }
  .theme-toggle-container input { display: none; }
  
  .toggle-track {
    width: 60px; height: 30px; border-radius: 30px;
    border: 2px solid #b5b9c5; background-color: transparent;
    display: flex; align-items: center; position: relative;
    cursor: pointer; transition: all 0.0s ease; /* Removido o transition inicial pra evitar FOUC */
  }
  
  .toggle-thumb {
    width: 22px; height: 22px; border-radius: 50%;
    background-color: #8c93a8; position: absolute; left: 3px;
    display: flex; justify-content: center; align-items: center;
    transition: transform 0.0s ease, background-color 0.0s ease; /* Removido pra carregar instantaneamente na posição certa */
  }
  
  .toggle-thumb svg { width: 12px; height: 12px; }
  .icon-moon { stroke: #ffffff; }
  .icon-sun { display: none; stroke: #a855f7; }

  /* Estado Claro (Sol) via attribute global */
  html[data-theme='light'] .toggle-track { background-color: #a855f7; border-color: #a855f7; }
  html[data-theme='light'] .toggle-thumb { transform: translateX(30px); background-color: #ffffff; }
  html[data-theme='light'] .icon-moon { display: none; }
  html[data-theme='light'] .icon-sun { display: block; }
  
  /* Habilita transição apenas após o carregamento da página */
  html[data-theme-loaded] .toggle-track { transition: all 0.3s ease; }
  html[data-theme-loaded] .toggle-thumb { transition: transform 0.3s ease, background-color 0.3s ease; }
</style>

<script>
  function initThemeToggle() {
    const themeSwitch = document.getElementById('theme-switch') as HTMLInputElement | null;

    if (themeSwitch) {
      // Sincroniza o estado inicial do botão com o tema do HTML
      if (document.documentElement.getAttribute('data-theme') === 'light') {
        themeSwitch.checked = true;
      } else {
        themeSwitch.checked = false;
      }
      
      // Habilita a transição css depois pra evitar animação na carga inicial
      setTimeout(() => {
        document.documentElement.setAttribute('data-theme-loaded', 'true');
      }, 50);

      themeSwitch.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.checked) {
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    }
  }

  // Executa na inicialização padrão
  initThemeToggle();
  // Executa caso use Astro ViewTransitions futuramente
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>