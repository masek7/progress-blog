---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>

    <nav>
      <a href="/">Home</a>
      <a href="/matematica">Matemática</a>
      <a href="/computacao">Computação</a>
      <a href="/sobre">Sobre</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p class="muted">feito por Guilherme</p>
    </footer>

  </body>
</html>