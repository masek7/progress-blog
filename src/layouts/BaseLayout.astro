---
// 1. O CSS é importado aqui no topo!
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Pega a URL base e remove a barra final
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>

    <nav>
      <a href={`${base}/`}>Home</a>
      <a href={`${base}/matematica`}>Matemática</a>
      <a href={`${base}/computacao`}>Computação</a>
      <a href={`${base}/python`}>Python</a>
      <a href={`${base}/sql`}>SQL</a>
      <a href={`${base}/sobre`}>Sobre</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p class="muted">feito por Guilherme</p>
    </footer>

  </body>
</html>