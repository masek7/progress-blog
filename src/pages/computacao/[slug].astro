---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('computacao');
  
  return posts.map(post => {
    const slugLimpo = post.id.replace(/\.md$/, ''); 
    return {
      params: { slug: slugLimpo },
      props: { post }, // Passa o post envelopado no objeto props
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={post.data.title}>
  <a href={`${base}/computacao`}>← Voltar</a>

  <h1>{post.data.title}</h1>
  <p class="muted">
    {new Date(post.data.pubDate).toLocaleDateString('pt-BR')}
  </p>

  <article>
    <Content />
  </article>
</BaseLayout>